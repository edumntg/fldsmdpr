{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FLDSMDPR",
  "version": "0.1.0",
  "identifier": "com.eduardomontilva.fldsmdpr",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FLDSMDPR",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "copyright": "© 2026 Eduardo Montilva",
    "shortDescription": "Fully Local Dispatcher for Slack, Messages, Dev-tasks & PRs",
    "longDescription": "One inbox for everything a developer needs to act on — PR reviews, Slack mentions, Linear tickets, and calendar events — with a Claude Code agent one click away.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "entitlements": "entitlements.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
