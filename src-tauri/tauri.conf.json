{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FLDSMDPR",
  "version": "0.3.2",
  "identifier": "com.eduardomontilva.fldsmdpr",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FLDSMDPR",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "transparent": true,
        "windowEffects": {
          "effects": [
            "sidebar"
          ],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "copyright": "© 2026 Eduardo Montilva",
    "shortDescription": "Fully Local Dispatcher for Sentry, Meetings, Dev-tasks & PRs",
    "longDescription": "One inbox for everything a developer needs to act on — PR reviews, Linear tickets, Sentry errors, meetings and calendar events — with a Claude Code agent one click away.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "entitlements": "entitlements.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYzMkFGMkJBQzQ5MUM0MkIKUldRcnhKSEV1dklxOCt3K3pLT3dWWGRvR2RnNllma01CM0dwZkU5am1BOC95REF5blJHS3RBRnIK",
      "endpoints": [
        "https://github.com/edumntg/fldsmdpr/releases/latest/download/latest.json"
      ]
    }
  }
}
